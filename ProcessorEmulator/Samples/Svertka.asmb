; Выполняет свертку двух массивов с 10 элементами
; Распределение памяти:
; 0х01 - 0х0a - массив 1
; 0х0b - 0x14 - массив 2
; 0х15 - текущий индекс (=10, 9-0, 0 - выход)
; 0х16 - итоговое значение
; 0x17 - для произведения Ai*Bi
; 0x18 - начало массива 1 (=1)
; 0х19 - начало массива 2 (=b (11))

DEC 0x15; 1 - начало итерации цикла
STOR 0x15; 2
JL 0x13; 3 - выход из цикла

LOAD 0x18; 4 - ищем ячейку памяти для текущего индекса массива 1
ADD 0x15; 5
STOR MAR; 6 - отправляем в mar (в mdr появится значение)
LOAD MDR; 7
STOR 0x17; 8

LOAD 0x19; 9 - аналогично для массива 2
ADD 0x15; a
STOR MAR; b
LOAD MDR; c
MUL 0x17; d

STOR 0x17; e - сохраняем в 0х17 произведение

LOAD 0x16; f
ADD 0x17; 10
STOR 0x16; 11

JMP 0x01; 12 - конец итерации цикла

LOAD 0x16; 13
STOR OUT; 14