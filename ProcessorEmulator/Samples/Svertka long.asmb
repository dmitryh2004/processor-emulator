; Выполняет свертку двух массивов с 10 элементами
; Распределение памяти:
; 0х01 - 0х0a - массив 1
; 0х0b - 0x14 - массив 2
; 0х15 - текущий индекс (=10, 9-0, 0 - выход)
; 0х16 - 0х18 - итоговое значение (S2-S0)
; 0x19 - 0x10000 для умножения/деления разрядов
; 0x1A - 0х1B - для произведения Ai*Bi (R2-R0)
; 0x1C - значение Ai
; 0x1D - значение Bi
; 0x1E - начало массива 1 (=1)
; 0х1F - начало массива 2 (=b (11))
; 0x20 - 0xFFFF для выделения групп разрядов через маски (LOAD 0x20 -> AND ... для младших битов, NOT 0x20 -> AND ... для старших)
; 0x21 - старшие биты Ai (A1)
; 0x22 - младшие биты Ai (A0)
; 0x23 - старшие биты Bi (B1)
; 0x24 - младшие биты Bi (B0)
; 0x25 - 0x28 - C3-C0
; 0x29 - T

DEC 0x15; начало итерации цикла
STOR 0x15
JL 0x78; выход из цикла

LOAD 0x1e; ищем ячейку памяти для текущего индекса массива 1
ADD 0x15
STOR MAR; отправляем в mar (в mdr появится значение)
LOAD MDR
STOR 0x1c; отправляем в Ai

LOAD 0x1f; аналогично для массива 2
ADD 0x15
STOR MAR
LOAD MDR
STOR 0x1d; отправляем в Bi

; вычисляем младшие и старшие биты
NOT 0x20
AND 0x1c
DIV 0x19
STOR 0x21 ; старшие А

LOAD 0x20
AND 0x1c
STOR 0x22 ; младшие А

NOT 0x20
AND 0x1d
DIV 0x19
STOR 0x23 ; старшие B

LOAD 0x20
AND 0x1d
STOR 0x24 ; младшие B

; очищаем C3-C0
CLS
STOR 0x25
STOR 0x26
STOR 0x27
STOR 0x28

; вычисляем A0 * B0
LOAD 0x22
MUL 0x24
STOR 0x29; в T

LOAD 0x20
AND 0x29
ADD 0x28
STOR 0x28 ; C0

NOT 0x20
AND 0x29
DIV 0x19
ADD 0x27
STOR 0x27 ; C1

; вычисляем A1 * B0
LOAD 0x21
MUL 0x24
STOR 0x29; в T

LOAD 0x20
AND 0x29
ADD 0x27
STOR 0x27 ; C1
DIV 0x19
ADD 0x26
STOR 0x26 ; add to C2

LOAD 0x27
AND 0x20
STOR 0x27 ; remove top 16 bits C1

NOT 0x20
AND 0x29
DIV 0x19
ADD 0x26
STOR 0x26 ; C2

; вычисляем A0 * B1
LOAD 0x22
MUL 0x23
STOR 0x29 ; в T

LOAD 0x20
AND 0x29
ADD 0x27
STOR 0x27 ; C1
DIV 0x19
ADD 0x26
STOR 0x26 ; add to C2

LOAD 0x27
AND 0x20
STOR 0x27 ; remove top 16 bits C1

NOT 0x20
AND 0x29
DIV 0x19
ADD 0x26
STOR 0x26 ; C2

; вычисляем A1 * B1
LOAD 0x21
MUL 0x23
STOR 0x29 ; T

LOAD 0x20
AND 0x29
ADD 0x26
STOR 0x26 ; C2
DIV 0x19
ADD 0x25
STOR 0x25 ; add to C3

LOAD 0x26
AND 0x20
STOR 0x26 ; remove top 16 bits C2

NOT 0x20
AND 0x29
DIV 0x19
ADD 0x25
STOR 0x25 ; C3

; add C3-C0 to R1-R0
; get C1-C0
INC 0x20
MUL 0x27
ADD 0x28
STOR 0x1b ; R0

INC 0x20
MUL 0x25
ADD 0x26
STOR 0x1a ; R1

; add R1-R0 to S1-S0
LOAD 0x18
ADD 0x1b
STOR 0x18 ; S0
JNC 0x71
INC 0x17
STOR 0x17 ; S1

LOAD 0x17
ADD 0x1a
STOR 0x17 ; S1
JNC 0x77
INC 0x16
STOR 0x16 ; S2

JMP 0x01 ; возврат в начало цикла за следующими числами

LOAD 0x16
STOR OUT
LOAD 0x17
STOR OUT
LOAD 0x18
STOR OUT