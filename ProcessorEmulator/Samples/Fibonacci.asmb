; Вычисляет N-е число Фибоначчи, считая первые 2 числа равными 1.
; Распределение ячеек памяти:
; 0x01 - N (какое число нужно вычислить)
; 0x02 - число Фибоначчи №1 (=1)
; 0х03 - число Фибоначчи №2 (=1)
; 0х04 - буфер (=0)

LOAD 0x01; 1
DEC AC; 2
DEC AC; 3
JL 0x10; 4
JE 0x10; 5

STOR 0x01; 6
LOAD 0x03; 7
STOR 0x04; 8
LOAD 0x02; 9
STOR 0x03; a
LOAD 0x04; b
ADD 0x03; c
STOR 0x02; d
DEC 0x01; e
JMP 0x04; f

LOAD 0x02; 10
STOR OUT; 11